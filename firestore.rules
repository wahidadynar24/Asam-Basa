rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Pengguna terautentikasi
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: Guru terverifikasi (berdasarkan email resmi pendidik)
    function isOfficialTeacher() {
      return isAuthenticated() && (
        request.auth.token.email == 'karenina.zulfa.2403316@students.um.ac.id' ||
        request.auth.token.email == 'guru@chemify.edu'
      );
    }
    
    // Helper: Kepemilikan dokumen pengguna
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Koleksi Profil Pengguna
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isOfficialTeacher());
      allow create, update: if isAuthenticated() && isOwner(userId);
      allow delete: if false;
    }

    // Koleksi Kemajuan Belajar Siswa (5E)
    match /student_progress/{userId} {
      // Siswa hanya boleh membaca progres miliknya, Guru resmi boleh membaca seluruh data siswa
      allow read: if isAuthenticated() && (isOwner(userId) || isOfficialTeacher());
      // Siswa hanya boleh menulis dokumen miliknya; Guru dilarang mengubah data belajar siswa
      allow create, update: if isAuthenticated() && isOwner(userId);
      allow delete: if false;
    }

    // Koleksi Rekapitulasi Hasil Evaluasi Kuis
    match /quiz_results/{attemptId} {
      // Siswa hanya boleh membaca hasil miliknya, Guru resmi boleh membaca semua hasil
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isOfficialTeacher()
      );
      // Siswa hanya boleh menulis hasil kuis miliknya sendiri
      allow create, update: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if false;
    }

    // Tolak semua akses lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
